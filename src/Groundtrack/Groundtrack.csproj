<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net7.0-windows;net48</TargetFrameworks>
    <AssemblyName>groundtrack</AssemblyName>
    <RootNamespace>Groundtrack</RootNamespace>
    <TargetExt>.gha</TargetExt>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.4.0</Version>
    <Title>groundtrack</Title>
    <Description>Movement fields, streamlines, particles, crossings and a timeline for Grasshopper</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>NU1701;CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net7.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png" />
    <EmbeddedResource Include="Resources\hou_pop_build.py" LogicalName="hou_pop_build.py" />
  </ItemGroup>

</Project>
